# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="AI Career Navigator"
# Leave blank until a real vLLM endpoint is provisioned. Never paste secrets into chat.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=Qwen/Qwen3-4B-Instruct-2507
# No shared demo password. Existing DEMO_ACCESS_CODE is obsolete and ignored.
# Optional existing server SESSION_SECRET signs anonymous cookies; never send it to JS.
# If absent, an internal signing key is kept in the private quota directory.
SESSION_SECRET=
# Rolling limits. SQLite survives process restarts on the same disk, not new disks.
MAX_DAILY_ANALYSES=20
MAX_HOURLY_ANALYSES=10
MAX_CLIENT_HOURLY_ANALYSES=3
MAX_CLIENT_DAILY_ANALYSES=6
ANALYSIS_COOLDOWN_SECONDS=60
# Optional persistent writable directory; must not be served as static files.
# LIMIT_STATE_DIR=/persistent/career-runtime
# PUBLIC_APP_ORIGIN=https://ai-career-navigator-xyf20070924.replit.app
